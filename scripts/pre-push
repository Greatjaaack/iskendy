#!/bin/sh
# Не пускать в main то, что не проходит тесты.
#
# Деплой на сервере делает `git pull` из main — сломанный код доедет до прода
# ближайшей ночью, и узнаем мы об этом, когда табло не поднимется. Тесты идут
# полторы секунды, так что цена проверки нулевая.
#
# Это быстрая подстраховка, а не гарантия: обходится флагом --no-verify и живёт
# только на этой машине. Настоящий сторож — GitHub Actions.
#
# Ставится через scripts/install-hooks.sh
set -e

if ! command -v poetry >/dev/null 2>&1; then
  echo "pre-push: poetry не найден, тесты пропущены" >&2
  exit 0
fi

echo "pre-push: прогоняю тесты…"
if poetry run pytest -q; then
  echo "pre-push: тесты прошли, пушу"
else
  echo "" >&2
  echo "pre-push: ТЕСТЫ НЕ ПРОШЛИ — пуш остановлен." >&2
  echo "Починить или, если точно уверен: git push --no-verify" >&2
  exit 1
fi
