FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY backend-requirements.txt /test/backend-requirements.txt
RUN pip install --no-cache-dir -r /test/backend-requirements.txt
COPY reference /reference
COPY dist /dist
COPY local-backend-spike.py /test/local-backend-spike.py
RUN git config --system --add safe.directory /reference
ENV PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
EXPOSE 8099
ENTRYPOINT ["python", "/test/local-backend-spike.py", "--backend", "/reference", "--dist", "/dist", "--port", "8099", "--container-listen"]
