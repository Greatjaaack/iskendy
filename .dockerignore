# Шаблоны без **/ Docker сопоставляет только с корнем контекста: «.venv»
# не поймает «backend/.venv». Отсюда двойная запись у всего, что встречается
# и в корне, и во вложенных каталогах.
.git
.gitignore
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite3
**/.env
.idea
.vscode
**/.DS_Store
README.md
TASKS.md
docs/
