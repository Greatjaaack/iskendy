# Пароль персонала для экрана кассы. Пустой = вход выключен.
STAFF_PASSWORD=

# Секрет подписи JWT. Если пусто — выводится из пароля (можно не задавать).
JWT_SECRET=
JWT_TTL_HOURS=24

# Часовой пояс ресторана (по нему считается «сегодня»).
TIMEZONE=Europe/Moscow

# Путь к SQLite-файлу.
DB_PATH=iskendy.db

# Дефолты нового дня.
DEFAULT_TOTAL_BATCHES=40
DEFAULT_START_TIME=12:00
DEFAULT_INTERVAL_MIN=15
BATCH_SIZE=7

# --- Отзывы гостей (см. docs/feedback-flow.md) ---
# Ссылки на формы отзывов и соцсети.
REVIEW_URL_YANDEX=
REVIEW_URL_2GIS=
SOCIAL_URL_TELEGRAM=
SOCIAL_URL_INSTAGRAM=
SOCIAL_URL_VK=                   # пусто — кнопка не показывается

# Уведомления об отзывах в Telegram.
FEEDBACK_ALERT_ENABLED=true      # общий рубильник уведомлений
TELEGRAM_BOT_TOKEN=              # @BotFather
BOT_PROXY_URL=                   # http://user:pass@host:port — Telegram из РФ напрямую не отвечает
TELEGRAM_ALERT_TARGETS=          # негатив — сюда. chat_id[:thread_id], через запятую. Напр. 12345,-100999:800
FEEDBACK_NOTIFY_ALL=true         # уведомлять и о хороших отзывах тоже
TELEGRAM_FEEDBACK_TARGETS=       # куда хорошие отзывы. Пусто — в чат из TELEGRAM_DIGEST_TARGET
TELEGRAM_DIGEST_TARGET=          # куда вечернюю сводку (необязательно)
FEEDBACK_NEGATIVE_MAX=3          # оценка <= этой считается негативом
FEEDBACK_PROMPT_DELAY_SEC=180    # пауза после «выдано» до экрана оценки
FEEDBACK_EDIT_WINDOW_MIN=120     # сколько гость может править отзыв и оценку
