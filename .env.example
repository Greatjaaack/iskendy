# Пароль персонала для экрана кассы. Пустой = вход выключен.
STAFF_PASSWORD=

# Секрет подписи JWT. Если пусто — выводится из пароля (можно не задавать).
JWT_SECRET=
JWT_TTL_HOURS=24                 # в проде намеренно больше: планшет кассы
                                 # не разлогинивают, пароль вводить неудобно.
                                 # Защита — одна активная сессия, а не короткий срок.

# Часовой пояс ресторана (по нему считается «сегодня»).
TIMEZONE=Europe/Moscow

# Путь к SQLite-файлу.
DB_PATH=iskendy.db

# --- Заказы из iiko (через ручку аналитики) ---
IIKO_ORDERS_URL=                 # напр. http://dashboards-backend-1:8000/api/orders/today; пусто — поллер выключен
IIKO_INTERNAL_TOKEN=             # заголовок X-Internal-Token к ручке аналитики
IIKO_POLL_SECONDS=30             # период опроса
IIKO_INGEST_WINDOW_MIN=20        # заводим только заказы, открытые за последние N минут
ANALYTICS_SUMMARY_URL=           # ручка аналитики с деньгами для вечерней сводки;
                                 # пусто — выведется из IIKO_ORDERS_URL, обе живут
                                 # на одном сервисе. Токен тот же, IIKO_INTERNAL_TOKEN

# --- Бэкап БД ---
BACKUP_ENABLED=true
BACKUP_KEEP=30                   # сколько суточных копий хранить
BACKUP_NIGHT_HOUR=3              # час ночи, когда снимать копию

# --- Отзывы гостей (см. docs/feedback-flow.md) ---
# Ссылки на формы отзывов и соцсети.
REVIEW_URL_YANDEX=
REVIEW_URL_2GIS=
SOCIAL_URL_TELEGRAM=
SOCIAL_URL_INSTAGRAM=
SOCIAL_URL_VK=                   # пусто — кнопка не показывается

# Уведомления об отзывах в Telegram.
FEEDBACK_ALERT_ENABLED=true      # общий рубильник уведомлений
TELEGRAM_BOT_TOKEN=              # @BotFather
BOT_PROXY_URL=                   # http://user:pass@host:port — Telegram из РФ напрямую не отвечает
# Адресаты: chat_id[:thread_id] через запятую. Задавать ВСЕ ТРИ явно — пустой
# FEEDBACK подставляется из DIGEST по цепочке, и правка одного уводит отзывы
# не туда. Личных адресатов не ставить: система должна работать без владельца.
TELEGRAM_ALERT_TARGETS=          # сбои и безопасность. Напр. -1009999:858
TELEGRAM_FEEDBACK_TARGETS=       # отзывы гостей, обе ветки. Напр. -1009999:800
TELEGRAM_DIGEST_TARGET=          # вечерняя сводка. Тут личка — в ней выручка,
                                 # а в рабочем чате сидит вся смена
DIGEST_ENABLED=true              # рубильник вечерней сводки
DIGEST_HOUR=0                    # час отправки, за ПРОШЕДШИЙ день
FEEDBACK_NOTIFY_ALL=true         # слать и хорошие отзывы, не только жалобы
FEEDBACK_NEGATIVE_MAX=3          # оценка <= этой считается негативом
FEEDBACK_PROMPT_DELAY_SEC=180    # пауза после «выдано» до экрана оценки
FEEDBACK_EDIT_WINDOW_MIN=120     # сколько гость может править отзыв и оценку
