{
  "name": "iskendy-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:mock": "node scripts/dev-mock.mjs",
    "dev:kit": "node scripts/dev-kit.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests dev scripts/*.mjs *.ts *.json *.html .github/workflows/*.yml",
    "format:check": "prettier --check src tests dev scripts/*.mjs *.ts *.json *.html .github/workflows/*.yml",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:real": "node scripts/check-real-origin.mjs",
    "build": "vite build && node scripts/assemble-release.mjs",
    "check:size": "node scripts/check-size.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:tokens && npm test && npm run build && npm run check:size && npm run test:e2e",
    "preview": "vite preview --host 0.0.0.0",
    "assemble-release": "node scripts/assemble-release.mjs",
    "browsers:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium webkit"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "@fontsource/rubik": "5.3.0",
    "@gsap/react": "2.1.2",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slider": "1.5.0",
    "@tanstack/react-query": "5.104.1",
    "gsap": "3.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "msw": "2.15.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vite-imagetools": "12.0.1",
    "vitest": "5.0.3"
  }
}
